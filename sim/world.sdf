<?xml version="1.0"?>
<sdf version="1.10">
  <world name="mono_lab">
    <physics name="physics" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.55 0.55 0.55 1</ambient><background>0.12 0.16 0.18 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.3 0.2 -1</direction><cast_shadows>true</cast_shadows></light>
    <model name="ground"><static>true</static><link name="ground_link"><collision name="floor_collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name="floor"><geometry><plane><normal>0 0 1</normal><size>8 6</size></plane></geometry><material><ambient>0.45 0.49 0.47 1</ambient><diffuse>0.45 0.49 0.47 1</diffuse></material></visual></link></model>
    <model name="back_wall"><static>true</static><pose>3.7 0 0.75 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>0.15 6 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.15 6 1.5</size></box></geometry><material><ambient>0.62 0.66 0.64 1</ambient><diffuse>0.62 0.66 0.64 1</diffuse></material></visual></link></model>
    <model name="left_wall"><static>true</static><pose>0 2.9 0.5 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>7.5 0.15 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>7.5 0.15 1</size></box></geometry><material><ambient>0.35 0.43 0.48 1</ambient><diffuse>0.35 0.43 0.48 1</diffuse></material></visual></link></model>
    <model name="right_wall"><static>true</static><pose>0 -2.9 0.5 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>7.5 0.15 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>7.5 0.15 1</size></box></geometry><material><ambient>0.35 0.43 0.48 1</ambient><diffuse>0.35 0.43 0.48 1</diffuse></material></visual></link></model>
    <model name="obstacle_red"><static>true</static><pose>-0.5 0 0.4 0 0 0</pose><link name="box"><collision name="collision"><geometry><box><size>0.6 0.7 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 0.7 0.8</size></box></geometry><material><ambient>0.7 0.22 0.15 1</ambient><diffuse>0.7 0.22 0.15 1</diffuse></material></visual></link></model>
    <model name="obstacle_blue"><static>true</static><pose>1.2 1.1 0.55 0 0 0.3</pose><link name="box"><collision name="collision"><geometry><box><size>0.7 0.7 1.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.7 0.7 1.1</size></box></geometry><material><ambient>0.2 0.38 0.65 1</ambient><diffuse>0.2 0.38 0.65 1</diffuse></material></visual></link></model>
    <model name="obstacle_gold"><static>true</static><pose>2 -1 0.3 0 0 0</pose><link name="box"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>0.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>0.6</length></cylinder></geometry><material><ambient>0.75 0.6 0.2 1</ambient><diffuse>0.75 0.6 0.2 1</diffuse></material></visual></link></model>
    <model name="mono_bot">
      <pose>-2.7 0 0.01 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0.18 0 0 0</pose>
        <inertial><mass>2</mass><inertia><ixx>0.025</ixx><iyy>0.04</iyy><izz>0.055</izz></inertia></inertial>
        <collision name="body_collision"><geometry><box><size>0.42 0.3 0.12</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.42 0.3 0.12</size></box></geometry><material><ambient>0.2 0.65 0.5 1</ambient><diffuse>0.2 0.65 0.5 1</diffuse></material></visual>
        <sensor name="body_contact" type="contact"><always_on>true</always_on><update_rate>20</update_rate><topic>/mono_bot/contacts</topic><contact><collision>body_collision</collision></contact></sensor>
      </link>
      <link name="left_wheel"><pose>0 0.18 0.09 1.57079632679 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0008</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry><material><ambient>0.08 0.1 0.1 1</ambient><diffuse>0.08 0.1 0.1 1</diffuse></material></visual></link>
      <link name="right_wheel"><pose>0 -0.18 0.09 1.57079632679 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0008</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry><material><ambient>0.08 0.1 0.1 1</ambient><diffuse>0.08 0.1 0.1 1</diffuse></material></visual></link>
      <link name="caster"><pose>-0.15 0 0.04 0 0 0</pose><inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial><collision name="collision"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision><visual name="visual"><geometry><sphere><radius>0.04</radius></sphere></geometry></visual></link>
      <link name="camera_link"><pose>0.23 0 0.29 0 0.12 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial><visual name="camera"><geometry><box><size>0.05 0.08 0.04</size></box></geometry><material><ambient>0.05 0.08 0.08 1</ambient><diffuse>0.05 0.08 0.08 1</diffuse></material></visual><sensor name="rgb_camera" type="camera"><always_on>true</always_on><update_rate>15</update_rate><topic>/camera/image</topic><camera><horizontal_fov>1.0471975512</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.05</near><far>12</far></clip></camera></sensor></link>
      <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="caster_joint" type="fixed"><parent>base_link</parent><child>caster</child></joint>
      <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.36</wheel_separation><wheel_radius>0.09</wheel_radius><topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency></plugin>
    </model>
  </world>
</sdf>
